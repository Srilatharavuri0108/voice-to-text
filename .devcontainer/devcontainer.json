{
  "name": "Speech-to-Text Streamlit App",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11",
  "forwardPorts": [8501],
  "postCreateCommand": "pip install -r requirements.txt",
  "postStartCommand": "streamlit run app.py --server.port=8501 --server.headless=true",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
